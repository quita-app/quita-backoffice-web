{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/actuator/:path*",
      "destination": "https://quitaapp-api.onrender.com/actuator/:path*"
    },
    { "source": "/api/:path*", "destination": "https://quitaapp-api.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(federation.manifest.json|app-config.json|quita-analytics.js)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
