{
  "name": "operations",
  "implicitDependencies": ["shared-design-tokens"],
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "quita",
  "sourceRoot": "apps/operations/src",
  "tags": ["type:app", "scope:operations", "framework:angular"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/operations",
        "browser": "apps/operations/src/main.ts",
        "tsConfig": "apps/operations/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/operations/public"
          }
        ],
        "styles": ["libs/shared/design-tokens/src/tokens.css", "apps/operations/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "operations:build:production"
        },
        "development": {
          "buildTarget": "operations:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "operations:build",
        "port": 4201,
        "staticFilePath": "dist/apps/operations/browser",
        "spa": true
      }
    }
  }
}
