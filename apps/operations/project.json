{
  "name": "operations",
  "implicitDependencies": [
    "shared-design-tokens"
  ],
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "quita",
  "sourceRoot": "apps/operations/src",
  "tags": [
    "type:app",
    "scope:operations",
    "framework:angular"
  ],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "defaultConfiguration": "production",
      "options": {
        "cacheExternalArtifacts": true,
        "tsConfig": "apps/operations/tsconfig.federation.json"
      },
      "configurations": {
        "production": {
          "target": "operations:esbuild:production"
        },
        "development": {
          "target": "operations:esbuild:development",
          "dev": true
        }
      }
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "operations:serve-original:development",
        "tsConfig": "apps/operations/tsconfig.federation.json",
        "rebuildDelay": 500,
        "cacheExternalArtifacts": true,
        "dev": true,
        "devServer": true,
        "port": 0
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": [
        "build"
      ],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "operations:build",
        "port": 4201,
        "staticFilePath": "dist/apps/operations/browser",
        "spa": true
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/operations",
        "browser": "apps/operations/src/main.ts",
        "tsConfig": "apps/operations/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/operations/public"
          }
        ],
        "styles": [
          "libs/shared/design-tokens/src/tokens.css",
          "apps/operations/src/styles.css"
        ],
        "polyfills": [
          "es-module-shims"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve-original": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "operations:esbuild:production"
        },
        "development": {
          "buildTarget": "operations:esbuild:development"
        }
      }
    }
  }
}